# Copy to .env and adjust.
SMOKESHIELD_MODEL_PATH=models/best.pt
SMOKESHIELD_CONFIDENCE=0.40
SMOKESHIELD_IMAGE_SIZE=640
# "cpu", "0" (first GPU) or "mps"; empty = auto
SMOKESHIELD_DEVICE=
# Defaults for new cameras (each camera can override them in the UI)
SMOKESHIELD_CONFIRM_FRAMES=3
SMOKESHIELD_CONFIRM_WINDOW=5
SMOKESHIELD_CAMERA_COOLDOWN=30
# Max inferences per second per camera; lower it on slow CPUs with many cameras
SMOKESHIELD_WORKER_FPS=4
# Seconds before the same class is logged as a new browser-webcam incident
SMOKESHIELD_INCIDENT_COOLDOWN=15
# Where the database, snapshots and uploaded videos live
SMOKESHIELD_DATA_DIR=data
SMOKESHIELD_CORS_ORIGINS=["http://localhost:5173"]

# Model registry: uploading .pt files can run code on the server, so switch off on shared hosts
SMOKESHIELD_MODEL_UPLOAD_ENABLED=true
SMOKESHIELD_MAX_MODEL_MB=200
SMOKESHIELD_MAX_MODEL_VERSIONS=20

# Alarm behaviour (see README: "Small flames")
# Keep an alarm, and its last box, this long after the last sighting so a flickering flame does not blink
SMOKESHIELD_ALARM_HOLD_SECONDS=3
# One detection at least this confident confirms at once, without waiting for N frames
SMOKESHIELD_INSTANT_CONFIDENCE=0.75
# Detections down to this confidence are reported as "weak" on the Live Monitor page (they never alarm)
SMOKESHIELD_WEAK_FLOOR=0.05
# Resolution requested from server webcams (many default to 640x480, which shrinks small flames)
SMOKESHIELD_DEVICE_CAPTURE_WIDTH=1280
SMOKESHIELD_DEVICE_CAPTURE_HEIGHT=720
